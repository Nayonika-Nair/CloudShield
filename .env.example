# Copy to .env and change every value. Never commit .env.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=cloudshield
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=cloudshield

# --- API ----------------------------------------------------------------
# Used to sign login tokens. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# --- Accounts created at start-up (leave blank to skip) --------------------
# admin: all simulator controls | analyst: scans, remediation, what-if, reports | viewer: read-only
ADMIN_EMAIL=admin@cloudshield.example.com
ADMIN_PASSWORD=change-me-admin-pass
ANALYST_EMAIL=analyst@cloudshield.example.com
ANALYST_PASSWORD=change-me-analyst-pass
VIEWER_EMAIL=viewer@cloudshield.example.com
VIEWER_PASSWORD=change-me-viewer-pass

# --- Simulator ----------------------------------------------------------
# Generate the default demonstration environment on a fresh database.
SEED_DEMO_ENVIRONMENT=true
# Advance simulated time automatically every N real seconds (0 = manual only).
SIM_AUTO_ADVANCE_SECONDS=0

# --- Local (non-Docker) development ---------------------------------------
# DATABASE_URL=postgresql://cloudshield:change-me-db-password@localhost:5432/cloudshield
# DATABASE_URL=sqlite:///./cloudshield-dev.db   # no PostgreSQL needed for a quick local run
# SERVE_FRONTEND=true                           # let uvicorn also serve ./frontend on the same port
